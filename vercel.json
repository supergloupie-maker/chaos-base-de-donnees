{
  "headers": [
    { "source": "/assets/map/satelite/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] },
    { "source": "/assets/(.*)\\.(css|js|svg)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" } ] }
  ]
}
